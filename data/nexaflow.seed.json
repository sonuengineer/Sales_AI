    { "id": "rule-01", "name": "Enterprise accounts → senior rep", "priority": 1, "field": "employeeSize", "operator": "IN", "value": ["1001-5000"], "assignTo": "sales-001" },
    { "id": "rule-02", "name": "Europe region → Priya", "priority": 2, "field": "region", "operator": "IN", "value": ["Europe"], "assignTo": "sales-002" },
    { "id": "rule-03", "name": "High-score leads (≥ 80) → senior rep", "priority": 3, "field": "score", "operator": "GTE", "value": "80", "assignTo": "sales-001" },
