  "workflows": [
    { "id": "wf-01", "workflow": "VALIDATION", "position": 1, "name": "Capture", "description": "A new lead arrives from any source (webinar, inbound, referral, outbound, content download).", "actor": "System", "condition": "Lead created" },
    { "id": "wf-02", "workflow": "VALIDATION", "position": 2, "name": "Enrich", "description": "Attach company data — industry, employee size and region — so the lead can be scored and routed.", "actor": "System", "condition": "Company matched" },
    { "id": "wf-03", "workflow": "VALIDATION", "position": 3, "name": "Dedupe", "description": "Check for existing contacts at the same company and merge duplicates before they enter the pipeline.", "actor": "System", "condition": "Duplicate detected" },
    { "id": "wf-04", "workflow": "VALIDATION", "position": 4, "name": "Validate", "description": "Verify the email format and that the contact is relevant; flag invalid records for review.", "actor": "Sales operations", "condition": "All leads" },
    { "id": "wf-05", "workflow": "ASSIGNMENT", "position": 1, "name": "Score", "description": "Compute a 0–100 lead score from company fit, industry fit, decision-maker role, engagement and intent.", "actor": "System", "condition": "Score 0–100" },
    { "id": "wf-06", "workflow": "ASSIGNMENT", "position": 2, "name": "Match rules", "description": "Evaluate assignment rules in priority order — region, industry, employee size and score.", "actor": "System", "condition": "Rules enabled" },
    { "id": "wf-07", "workflow": "ASSIGNMENT", "position": 3, "name": "Check workload", "description": "Skip salespeople who are at capacity so no rep's pipeline gets overloaded.", "actor": "System", "condition": "Open leads < capacity" },
    { "id": "wf-08", "workflow": "ASSIGNMENT", "position": 4, "name": "Assign", "description": "Route the lead to the matched owner and log the rule that fired as the assignment reason.", "actor": "System", "condition": "Rule matched" },
    { "id": "wf-09", "workflow": "FOLLOW_UP", "position": 1, "name": "First contact", "description": "Reach out within 24 hours of assignment so the lead never goes cold.", "actor": "Sales rep", "condition": "TAT ≤ 1 day" },
    { "id": "wf-10", "workflow": "FOLLOW_UP", "position": 2, "name": "Cadence", "description": "Follow a structured cadence — call, email and LinkedIn — until the lead responds.", "actor": "Sales rep", "condition": "No reply after 3 days" },
    { "id": "wf-11", "workflow": "FOLLOW_UP", "position": 3, "name": "Log activity", "description": "Record every touch in the activity timeline so progress and TAT stay measurable.", "actor": "Sales rep", "condition": "After each touch" },
    { "id": "wf-12", "workflow": "FOLLOW_UP", "position": 4, "name": "Set next action", "description": "Always set a next action date so no lead slips through the cracks.", "actor": "Sales rep", "condition": "Always" },
    { "id": "wf-13", "workflow": "ESCALATION", "position": 1, "name": "Monitor staleness", "description": "Flag open leads with no activity for 7+ days as attention, at risk or stale.", "actor": "System", "condition": "7+ days no activity" },
    { "id": "wf-14", "workflow": "ESCALATION", "position": 2, "name": "Manager review", "description": "A manager reviews flagged leads and decides the next step — revive, reassign or archive.", "actor": "Manager", "condition": "AT_RISK or STALE" },
    { "id": "wf-15", "workflow": "ESCALATION", "position": 3, "name": "Re-route", "description": "Reassign leads that another rep could revive, or archive leads that cannot.", "actor": "Manager", "condition": "No reply after 15 days" },
    { "id": "wf-16", "workflow": "ESCALATION", "position": 4, "name": "Alert", "description": "Notify the owner and manager with an in-app stale-lead alert.", "actor": "System", "condition": "Alert generated" }
  ],
